# Copie este archivo como .streamlit/secrets.toml y complete sus datos.
# secrets.toml está en .gitignore: NUNCA se sube a GitHub.

[oracle]
user     = "APP_RESERVAS"          # usuario de la aplicación (sin DELETE ni DDL)
password = "******"
dsn      = "actionsport_tp"        # servicio del tnsnames.ora del wallet
schema   = "RESERVAS"              # dueño de las tablas

# ---- Opción A: Windows local (modo thick con Instant Client) ----
lib_dir    = 'C:\oracle\instantclient_23_26'
config_dir = 'C:\oracle\wallet_actionsport'

# ---- Opción B: Mac local (modo thin) ----
# config_dir      = "/Users/usuario/wallet_actionsport"
# wallet_password = "********"     # clave que se puso al descargar el wallet

# ---- Opción C: Streamlit Community Cloud (modo thin, sin archivos) ----
# Pegue el contenido de ewallet.pem y tnsnames.ora del wallet:
# wallet_password = "*******."
# wallet_pem = """
# -----BEGIN ENCRYPTED PRIVATE KEY-----
# ...
# """
# tnsnames = """
# actionsport_tp = (description= ...)
# """
